# Copy to backend/.env. Never commit a real key. The browser must not receive these values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# sqlite URL. Default is created under the storage root when empty.
DATABASE_URL=sqlite:///../data/studio.db
STORAGE_ROOT=../data
SESSION_DB_PATH=../data/sessions.db

# GPT-6.1 Sol is the fast near-flagship OpenAI model, used for every role. Any role can be set to a Claude id (claude-...) instead.
# Startup probes the OpenAI account and reports OpenAI ids it cannot see.
MODEL_ORCHESTRATOR=gpt-6.1-sol
MODEL_QUESTIONNAIRE=gpt-6.1-sol
MODEL_TABSPEC=gpt-6.1-sol
MODEL_ANALYSIS=gpt-6.1-sol
MODEL_CODING=gpt-6.1-sol
MODEL_VALIDATOR=gpt-6.1-sol
MODEL_GENERAL=gpt-6.1-sol
MODEL_SYNTHETIC=gpt-6.1-sol
# Census target research for weighting uses the model's web search (a ChatGPT or Claude model).
MODEL_RESEARCH=gpt-6.1-sol
MODEL_FALLBACK=gpt-6.1-sol

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
MAX_UPLOAD_MB=200
OPENAI_TRACING_DISABLED=true
RUN_TASKS_INLINE=false
LOG_ROW_TEXT=false

# Selfserve Decipher. Paste the API key. Leave it blank to keep XML download-only.
# The key stays on the server and is sent as the x-apikey header.
DECIPHER_API_BASE=https://selfserve.decipherinc.com/api/v1
DECIPHER_API_KEY=
DECIPHER_COMPANY=self

# Prolific researcher token. It stays on the server and is sent as Authorization: Token.
# Leave the key blank to refuse sample pricing. Set the workspace when the account has several.
PROLIFIC_API_BASE=https://api.prolific.com/api/v1
PROLIFIC_API_KEY=
PROLIFIC_WORKSPACE_ID=
PROLIFIC_PROJECT_ID=
# Connectors: OAuth clients for the ready-made MCP connectors (see README). Leave empty to hide sign-in.
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
SLACK_MCP_CLIENT_ID=
SLACK_MCP_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_MCP_CLIENT_ID=
MICROSOFT_MCP_CLIENT_SECRET=
# OAuth redirect base. Slack needs HTTPS (for example a tunnel to the backend).
PUBLIC_BASE_URL=http://localhost:8000
# Encrypts stored connector tokens. Empty generates data/connectors.key.
CONNECTOR_SECRET_KEY=
# Live quality: bot-detection API the Decipher tracker sends to (must be reachable by respondents).
BOT_DETECTION_API_BASE=https://bot-backend-119522247395.northamerica-northeast2.run.app/api/v1

# Shared with the bot-detection service (its TRACKING_TOKEN_SECRET); signs survey trackers. Empty = unsigned.
BOT_DETECTION_TOKEN_SECRET=
