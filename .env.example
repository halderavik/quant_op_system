# Copy to backend/.env. Never commit a real key. The browser must not receive these values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# sqlite URL. Default is created under the storage root when empty.
DATABASE_URL=sqlite:///../data/studio.db
STORAGE_ROOT=../data
SESSION_DB_PATH=../data/sessions.db

# GPT-6.1 Sol is the fast near-flagship OpenAI model. Coding jobs use Claude Sonnet 5.5.
# Startup probes the OpenAI account and reports OpenAI ids it cannot see.
MODEL_ORCHESTRATOR=gpt-6.1-sol
MODEL_QUESTIONNAIRE=gpt-6.1-sol
MODEL_TABSPEC=gpt-6.1-sol
MODEL_ANALYSIS=gpt-6.1-sol
MODEL_CODING=claude-sonnet-5-5
MODEL_VALIDATOR=gpt-6.1-sol
MODEL_GENERAL=gpt-6.1-sol
MODEL_FALLBACK=gpt-6.1-sol

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
MAX_UPLOAD_MB=200
OPENAI_TRACING_DISABLED=true
RUN_TASKS_INLINE=false
LOG_ROW_TEXT=false

# Selfserve Decipher. Paste the API key. Leave it blank to keep XML download-only.
# The key stays on the server and is sent as the x-apikey header.
DECIPHER_API_BASE=https://selfserve.decipherinc.com/api/v1
DECIPHER_API_KEY=
DECIPHER_COMPANY=self
